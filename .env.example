# ==============================================
# ApprovalApp Environment Variables Template
# ==============================================
# The defaults below are production-safe: they point at the public HTTPS
# origin. Copy this file to .env.local for local development and override
# the application URL variables with http://localhost:3000:
#   AUTH_URL="http://localhost:3000"
#   NEXTAUTH_URL="http://localhost:3000"
#   NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Copy this file to .env.production for Docker production and keep the
# public HTTPS origin below (all three URL variables must match).

# Application URL — all three variables must match the public origin.
# AUTH_URL is the canonical Auth.js v5 origin; NEXTAUTH_URL remains for
# backward compatibility. AUTH_TRUST_HOST=true lets Auth.js trust the
# host/protocol forwarded by the controlled Nginx reverse proxy.
AUTH_URL="https://approval.example.com"
NEXTAUTH_URL="https://approval.example.com"
NEXT_PUBLIC_APP_URL="https://approval.example.com"
AUTH_TRUST_HOST="true"

# Authentication secrets
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-a-random-secret"

# Database connection used by Prisma and the app.
# Development on host:
# DATABASE_URL="postgresql://postgres:changeme@localhost:5432/app_db?schema=public"
# Docker production:
# DATABASE_URL="postgresql://postgres:changeme@db:5432/app_db?schema=public"
DATABASE_URL="postgresql://postgres:changeme@db:5432/app_db?schema=public"

# Docker Compose PostgreSQL settings
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changeme"
POSTGRES_DB="app_db"

# File storage
# Private root mounted from the uploads_data volume in Docker (see compose).
# Leave as /app/uploads for containerized deploys; host dev may override.
UPLOAD_DIR="/app/uploads"

# Optional email notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional maintenance settings
ARCHIVE_AFTER_DAYS="90"
PUPPETEER_EXECUTABLE_PATH=""
