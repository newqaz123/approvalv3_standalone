generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model file_attachments {
  id           String     @id @default(uuid())
  requestId    String?
  fileName     String
  fileType     String
  fileSize     Int
  description  String?
  uploadedById String
  createdAt    DateTime   @default(now())
  filePath     String
  solutionId   String?
  request      requests?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution     solutions? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([solutionId])
  @@index([uploadedById])
}

model inline_description_images {
  id                String                               @id @default(uuid())
  uploadedById      String
  uploadSessionId   String
  fileName          String
  fileType          String
  originalSize      Int
  fileSize          Int
  filePath          String
  width             Int
  height            Int
  deletionPendingAt DateTime?
  createdAt         DateTime                             @default(now())
  uploadedBy        User                                 @relation(fields: [uploadedById], references: [id])
  references        inline_description_image_references[]

  @@index([uploadedById])
  @@index([uploadSessionId])
  @@index([createdAt])
  @@index([deletionPendingAt])
}

model inline_description_image_references {
  id         String                    @id @default(uuid())
  imageId    String
  requestId  String?
  solutionId String?
  templateId String?
  createdAt  DateTime                  @default(now())
  image      inline_description_images @relation(fields: [imageId], references: [id], onDelete: Cascade)
  request    requests?                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution   solutions?                @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  template   templates?                @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([imageId, requestId])
  @@unique([imageId, solutionId])
  @@unique([imageId, templateId])
  @@index([imageId])
  @@index([requestId])
  @@index([solutionId])
  @@index([templateId])
}

model notifications {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  requestId String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  request   requests?        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model request_activities {
  id         String         @id @default(uuid())
  requestId  String?
  action     String
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  comments   String?
  userId     String
  createdAt  DateTime       @default(now())
  request    requests?      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([requestId])
  @@index([userId])
}

model request_approvals {
  id                                                String                       @id @default(uuid())
  requestId                                         String
  approverId                                        String?
  order                                             Int
  status                                            ApprovalStatus               @default(pending)
  comments                                          String?
  approvedAt                                        DateTime?
  createdAt                                         DateTime                     @default(now())
  isFinalApproval                                   Boolean                      @default(false)
  requiredApproverId                                String?
  instanceId                                        String?
  requiredPositionId                                String?
  candidateGroupId                                  String?
  routingMode                                       ApprovalRoutingMode          @default(SNAPSHOT_GROUP)
  approver                                          User?                        @relation("request_approvals_approverIdTousers", fields: [approverId], references: [id])
  request                                           requests                     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requiredApprover                                  User?                        @relation("request_approvals_requiredApproverIdTousers", fields: [requiredApproverId], references: [id])
  instance                                          approval_instances?          @relation("request_approval_instance", fields: [instanceId], references: [id], onDelete: Restrict)
  candidateGroup                                    approval_candidate_groups?   @relation("request_approval_candidate_group", fields: [candidateGroupId], references: [id], onDelete: Restrict)
  requiredPositionRef                               positions?                    @relation("request_approvals_requiredPosition", fields: [requiredPositionId], references: [id], onDelete: Restrict)

  @@index([approverId])
  @@index([requestId])
  @@index([requiredApproverId])
  @@index([status])
  @@index([instanceId])
  @@index([candidateGroupId])
  @@index([requiredPositionId])
}

model request_engineer_assignments {
  id           String   @id @default(uuid())
  requestId    String
  engineerId   String
  assignedAt   DateTime @default(now())
  assignedById String?
  engineer     User    @relation(fields: [engineerId], references: [id])
  request      requests @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([requestId])
}

model sub_task_stages {
  id        String              @id @default(uuid())
  name      String              @unique
  sortOrder Int
  isDefault Boolean             @default(true)
  isOthers  Boolean             @default(false)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  subTasks  request_sub_tasks[]

  @@index([isActive])
  @@index([isOthers])
  @@index([sortOrder])
}

model sub_contractors {
  id          String              @id @default(uuid())
  name        String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String
  updatedById String?
  createdBy   User                @relation("sub_contractors_createdByIdTousers", fields: [createdById], references: [id])
  updatedBy   User?               @relation("sub_contractors_updatedByIdTousers", fields: [updatedById], references: [id])
  subTasks    request_sub_tasks[]

  @@index([createdById])
  @@index([isActive])
  @@index([updatedById])
}

model request_sub_tasks {
  id              String           @id @default(uuid())
  requestId       String
  description     String
  subContractorId String?
  stageId         String
  customStageText String?
  isCompleted     Boolean          @default(false)
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String
  updatedById     String?
  request         requests         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subContractor   sub_contractors? @relation(fields: [subContractorId], references: [id], onDelete: SetNull)
  stage           sub_task_stages  @relation(fields: [stageId], references: [id])
  createdBy       User             @relation("request_sub_tasks_createdByIdTousers", fields: [createdById], references: [id])
  updatedBy       User?            @relation("request_sub_tasks_updatedByIdTousers", fields: [updatedById], references: [id])
  completedBy     User?            @relation("request_sub_tasks_completedByIdTousers", fields: [completedById], references: [id])

  @@index([completedById])
  @@index([createdById])
  @@index([isCompleted])
  @@index([requestId])
  @@index([stageId])
  @@index([subContractorId])
  @@index([updatedAt])
  @@index([updatedById])
}

model budget_codes {
  id           String     @id @default(uuid())
  code         String     @unique
  displayCode  String
  name         String?
  budgetAmount Decimal?   @db.Decimal(15, 2)
  unitId       String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    User?      @relation("budget_codes_createdByIdTousers", fields: [createdById], references: [id])
  organizationUnit organization_units? @relation("budget_codes_unit", fields: [unitId], references: [id], onDelete: SetNull)
  requests     requests[]

  @@index([createdById])
  @@index([displayCode])
  @@index([unitId])
}

model requests {
  id                                String                         @id @default(uuid())
  title                             String
  description                       String
  status                            RequestStatus                  @default(ImprovementRequest)
  requesterId                       String
  organizationUnitId                String?
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  engineeringCostEstimate           Decimal?                       @db.Decimal(15, 2)
  engineeringSolution               String?
  deletedAt                         DateTime?
  deletedBy                         String?
  isDeleted                         Boolean                        @default(false)
  isArchived                        Boolean                        @default(false)
  budgetCodeId                      String?
  projectEstimateCost               Decimal?                       @db.Decimal(15, 2)
  workRequisitionReceived           Boolean                        @default(false)
  workRequisitionReceivedAt         DateTime?
  workRequisitionReceivedById       String?
  fileAttachments                   file_attachments[]
  inlineDescriptionImageReferences  inline_description_image_references[]
  notifications                     notifications[]
  activities                        request_activities[]
  approvals                         request_approvals[]
  engineerAssignments               request_engineer_assignments[]
  subTasks                          request_sub_tasks[]
  budgetCode                        budget_codes?                 @relation(fields: [budgetCodeId], references: [id], onDelete: SetNull)
  deletedByUser                     User?                         @relation("requests_deletedByTousers", fields: [deletedBy], references: [id])
  organizationUnit                  organization_units?           @relation(fields: [organizationUnitId], references: [id])
  requester                         User                          @relation("requests_requesterIdTousers", fields: [requesterId], references: [id])
  workRequisitionReceivedBy         User?                         @relation("requests_workRequisitionReceivedByIdTousers", fields: [workRequisitionReceivedById], references: [id])
  solutions                         solutions[]
  approvalInstances                 approval_instances[]

  @@index([budgetCodeId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([organizationUnitId])
  @@index([requesterId])
  @@index([status])
  @@index([workRequisitionReceived])
  @@index([workRequisitionReceivedById])
}

model solution_approvals {
  id                                                 String                       @id @default(uuid())
  solutionId                                         String
  requiredApproverId                                 String?
  approverId                                         String?
  order                                              Int
  status                                             ApprovalStatus               @default(pending)
  comments                                           String?
  approvedAt                                         DateTime?
  createdAt                                          DateTime                     @default(now())
  instanceId                                         String?
  requiredPositionId                                 String?
  candidateGroupId                                   String?
  routingMode                                        ApprovalRoutingMode          @default(SNAPSHOT_GROUP)
  approver                                           User?                        @relation("solution_approvals_approverIdTousers", fields: [approverId], references: [id])
  requiredApprover                                   User?                        @relation("solution_approvals_requiredApproverIdTousers", fields: [requiredApproverId], references: [id])
  solution                                           solutions                    @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  instance                                           approval_instances?          @relation("solution_approval_instance", fields: [instanceId], references: [id], onDelete: Restrict)
  candidateGroup                                     approval_candidate_groups?   @relation("solution_approval_candidate_group", fields: [candidateGroupId], references: [id], onDelete: Restrict)
  requiredPositionRef                                positions?                    @relation("solution_approvals_requiredPosition", fields: [requiredPositionId], references: [id], onDelete: Restrict)

  @@index([approverId])
  @@index([order])
  @@index([requiredApproverId])
  @@index([solutionId])
  @@index([status])
  @@index([instanceId])
  @@index([candidateGroupId])
  @@index([requiredPositionId])
}

model solutions {
  id                 String               @id @default(uuid())
  requestId          String
  title              String
  description        String
  costEstimate       Decimal              @db.Decimal(15, 2)
  currency           String               @default("THB")
  timeline           String?
  conceptDesign      String?
  submittedById      String
  submittedAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  fileAttachments                 file_attachments[]
  inlineDescriptionImageReferences inline_description_image_references[]
  approvals                       solution_approvals[]
  approvalInstances               approval_instances[]
  request            requests             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy        User                @relation(fields: [submittedById], references: [id])

  @@index([createdAt])
  @@index([requestId])
  @@index([submittedById])
}

model templates {
  id          String   @id @default(uuid())
  name        String
  title       String
  description String
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt                       DateTime                             @default(now())
  updatedAt                       DateTime                             @updatedAt
  inlineDescriptionImageReferences inline_description_image_references[]

  @@index([isActive])
  @@index([isDefault])
}

model retention_settings {
  id                        String   @id @default("default")
  archiveEnabled            Boolean  @default(true)
  archiveAfterDays          Int      @default(90)
  archiveStatuses           Json
  cleanupAfterDays          Int      @default(365)
  archiveHour               Int      @default(2)
  archiveMinute             Int      @default(0)
  lastArchiveRunOn          String?
  storageAlertThresholdPct  Int      @default(0)
  lastStorageAlertOn        String?
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model storage_plan_events {
  id          String   @id @default(uuid())
  label       String
  plannedDate DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("storage_plan_events_createdByIdTousers", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([plannedDate])
}

model email_settings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  provider          String   @default("custom")
  host              String
  port              Int      @default(587)
  username          String?
  passwordEncrypted String?
  fromAddress       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id                                                              String                         @id @default(uuid())
  email                                                           String                         @unique
  name                                                            String
  passwordHash                                                    String?
  role                                                            UserRole                       @default(general_dept)
  isActive                                                        Boolean                        @default(true)
  forcePasswordChange                                             Boolean                        @default(false)
  createdAt                                                       DateTime                       @default(now())
  updatedAt                                                       DateTime                       @updatedAt
  fileAttachments                                                file_attachments[]
  inlineDescriptionImages                                        inline_description_images[]
  notifications                                                   notifications[]
  requestActivities                                              request_activities[]
  approvedRequests                                               request_approvals[]            @relation("request_approvals_approverIdTousers")
  requiredApprovalRequests                                       request_approvals[]            @relation("request_approvals_requiredApproverIdTousers")
  createdBudgetCodes                                             budget_codes[]                 @relation("budget_codes_createdByIdTousers")
  engineerAssignments                                            request_engineer_assignments[]
  createdSubTasks                                                request_sub_tasks[]            @relation("request_sub_tasks_createdByIdTousers")
  updatedSubTasks                                                request_sub_tasks[]            @relation("request_sub_tasks_updatedByIdTousers")
  completedSubTasks                                              request_sub_tasks[]            @relation("request_sub_tasks_completedByIdTousers")
  createdSubContractors                                          sub_contractors[]              @relation("sub_contractors_createdByIdTousers")
  updatedSubContractors                                          sub_contractors[]              @relation("sub_contractors_updatedByIdTousers")
  deletedRequests                                                requests[]                     @relation("requests_deletedByTousers")
  createdRequests                                                requests[]                     @relation("requests_requesterIdTousers")
  workRequisitionRequests                                        requests[]                     @relation("requests_workRequisitionReceivedByIdTousers")
  approvedSolutions                                              solution_approvals[]           @relation("solution_approvals_approverIdTousers")
  requiredApprovalSolutions                                      solution_approvals[]           @relation("solution_approvals_requiredApproverIdTousers")
  solutions                                                       solutions[]
  createdStoragePlanEvents                                        storage_plan_events[]         @relation("storage_plan_events_createdByIdTousers")
  createdApprovalRouteVersions                                    approval_route_versions[]
  approvalInstancesOrigin                                         approval_instances[]           @relation("approval_instances_originUser")
  organizationAssignments                                         organization_assignments[]      @relation("organization_assignments_user")
  managedOrganizationUnits                                        organization_units[]            @relation("organization_units_manager")
  restartedApprovalInstances                                      approval_instances[]            @relation("approval_instances_restartedBy")

  @@index([isActive])
  @@map("users")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  approval_needed
  approval_granted
  approval_rejected
  status_changed
  request_assigned
  solution_ready
  final_approval_needed
}

enum RequestStatus {
  ImprovementRequest
  SentToEngineer
  SendBackToRequester
  Completed
  Cancelled
  DesignCostEstimationApproval
  FinalApproval
}

enum UserRole {
  admin
  general_dept
  engineering
}

enum ApprovalPhase {
  REQUEST
  SOLUTION
  FINAL
}

enum ApprovalRouteStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ApprovalRoutingMode {
  SNAPSHOT_GROUP
  CUSTOM_PERSON
}

enum ApprovalInstanceState {
  PENDING
  AUTO_APPROVED
  COMPLETED_NO_ELIGIBLE_STEPS
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum ApprovalSkipReason {
  VACANT_POSITION
}

model organization_units {
  id                    String                               @id @default(uuid())
  name                  String
  parentId              String?
  isActive              Boolean                              @default(true)
  shareRequests         Boolean                              @default(false)
  canWorkOnSolutions    Boolean                              @default(false)
  managerUserId         String?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt
  parent                organization_units?                  @relation("organization_units_parent", fields: [parentId], references: [id])
  children              organization_units[]                 @relation("organization_units_parent")
  routeVersions         approval_route_versions[]
  approvalInstances     approval_instances[]
  requests              requests[]
  manager               User?                                @relation("organization_units_manager", fields: [managerUserId], references: [id], onDelete: Restrict)
  assignments           organization_assignments[]           @relation("organization_assignments_unit")
  teams                 teams[]                              @relation("teams_unit")
  budgetCodes           budget_codes[]                      @relation("budget_codes_unit")
  companyRootSetting    company_settings?                    @relation("company_settings_rootUnit")

  @@index([parentId])
  @@index([isActive])
  @@index([managerUserId])
}

model approval_route_versions {
  id                   String                  @id @default(uuid())
  scopeUnitId          String
  phase                ApprovalPhase
  version              Int
  status               ApprovalRouteStatus     @default(DRAFT)
  createdById          String
  createdAt            DateTime                @default(now())
  publishedAt          DateTime?
  approvalLimitPositionId String
  scopeUnit            organization_units      @relation(fields: [scopeUnitId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  approvalLimitPosition positions              @relation("approval_route_versions_approvalLimitPosition", fields: [approvalLimitPositionId], references: [id], onDelete: Restrict)
  steps                approval_route_steps[]
  instances            approval_instances[]

  @@unique([scopeUnitId, phase, version])
  @@index([scopeUnitId, phase, status])
  @@index([approvalLimitPositionId])
}

model approval_route_steps {
  id               String                    @id @default(uuid())
  routeVersionId   String
  stepOrder        Int
  positionId       String
  createdAt        DateTime                  @default(now())
  routeVersion     approval_route_versions   @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  position         positions                 @relation("approval_route_steps_position", fields: [positionId], references: [id], onDelete: Restrict)
  skippedInstances approval_instance_skips[]

  @@unique([routeVersionId, stepOrder])
  @@unique([routeVersionId, positionId])
  @@index([positionId])
}

model approval_instances {
  id               String                     @id @default(uuid())
  requestId        String?
  solutionId       String?
  phase            ApprovalPhase
  routeVersionId   String?
  originUserId     String
  originUnitId     String
  routingMode      ApprovalRoutingMode
  state            ApprovalInstanceState      @default(PENDING)
  attempt          Int                        @default(1)
  completionReason String?
  createdAt        DateTime                   @default(now())
  // Task 8 ruling: supersession sets supersededAt while PRESERVING the prior
  // terminal state — AUTO_APPROVED is never erased into SUPERSEDED. The state
  // stays the durable audit proof for group-less auto self-rows.
  supersededAt     DateTime?
  originAssignmentId  String
  originPositionId    String
  restartOfInstanceId String?
  restartReason       String?
  restartedById       String?
  request          requests?                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution         solutions?                 @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  routeVersion     approval_route_versions?   @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  originUser       User                       @relation("approval_instances_originUser", fields: [originUserId], references: [id], onDelete: Restrict)
  originUnit       organization_units         @relation(fields: [originUnitId], references: [id], onDelete: Restrict)
  originAssignment organization_assignments   @relation("approval_instances_originAssignment", fields: [originAssignmentId], references: [id], onDelete: Restrict)
  originPosition   positions                  @relation("approval_instances_originPosition", fields: [originPositionId], references: [id], onDelete: Restrict)
  restartOf        approval_instances?        @relation("approval_instances_restart", fields: [restartOfInstanceId], references: [id], onDelete: Restrict)
  restartedFrom    approval_instances[]       @relation("approval_instances_restart")
  restartedBy      User?                      @relation("approval_instances_restartedBy", fields: [restartedById], references: [id], onDelete: Restrict)
  requestApprovals request_approvals[]        @relation("request_approval_instance")
  solutionApprovals solution_approvals[]      @relation("solution_approval_instance")
  skips            approval_instance_skips[]
  candidateGroups  approval_candidate_groups[]

  @@index([requestId, phase, supersededAt])
  @@index([solutionId, phase, supersededAt])
  @@index([routeVersionId])
  @@index([originAssignmentId])
  @@index([originPositionId])
  @@index([restartOfInstanceId])
  @@index([restartedById])
  @@unique([requestId, phase, attempt])
  @@unique([solutionId, phase, attempt])
}

model approval_instance_skips {
  id                String                    @id @default(uuid())
  approvalInstanceId String
  routeStepId       String?
  requiredPositionId String
  reason            ApprovalSkipReason
  createdAt         DateTime                  @default(now())
  approvalInstance  approval_instances        @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  routeStep         approval_route_steps?     @relation(fields: [routeStepId], references: [id], onDelete: SetNull)
  requiredPositionRef positions               @relation("approval_instance_skips_requiredPosition", fields: [requiredPositionId], references: [id], onDelete: Restrict)

  @@unique([approvalInstanceId, requiredPositionId])
  @@index([requiredPositionId])
}

model approval_candidate_groups {
  id                 String                               @id @default(uuid())
  approvalInstanceId String
  scopeUnitId        String
  requiredPositionId String
  capturedAt         DateTime                             @default(now())
  approvalInstance   approval_instances                   @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  requiredPositionRef positions                             @relation("approval_candidate_groups_requiredPosition", fields: [requiredPositionId], references: [id], onDelete: Restrict)
  members            approval_candidate_group_members[]
  requestApprovals   request_approvals[]                  @relation("request_approval_candidate_group")
  solutionApprovals  solution_approvals[]                 @relation("solution_approval_candidate_group")

  @@unique([approvalInstanceId, requiredPositionId])
  @@index([scopeUnitId])
  @@index([requiredPositionId])
}

model approval_candidate_group_members {
  candidateGroupId    String
  userId              String
  capturedAt          DateTime                    @default(now())
  capturedDisplayName String
  candidateGroup      approval_candidate_groups   @relation(fields: [candidateGroupId], references: [id], onDelete: Cascade)

  @@id([candidateGroupId, userId])
  @@index([userId])
}

// Clean-start organization schema (Plan B Task 15). Snapshot-constraint notes:
// every position reference uses Restrict so referenced positions can never be
// hard-deleted (deactivation is the removal path); the restart self-relation
// on approval_instances preserves the old attempt row; team-name uniqueness
// is a PARTIAL unique index on ACTIVE rows per unit (accepted A3 rule 7),
// carried in the squashed init migration because Prisma cannot express
// partial indexes.

model company_settings {
  id         String             @id @default("default")
  name       String
  rootUnitId String             @unique
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  rootUnit   organization_units @relation("company_settings_rootUnit", fields: [rootUnitId], references: [id], onDelete: Restrict)
}

model positions {
  id                                  String                      @id @default(uuid())
  name                                String                      @unique
  rank                                Int
  isActive                            Boolean                     @default(true)
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  assignments                         organization_assignments[]  @relation("organization_assignments_position")
  routeVersionsApprovalLimit          approval_route_versions[]   @relation("approval_route_versions_approvalLimitPosition")
  routeStepsPosition                  approval_route_steps[]      @relation("approval_route_steps_position")
  instancesOrigin                     approval_instances[]        @relation("approval_instances_originPosition")
  skipRowsRequiredPosition            approval_instance_skips[]    @relation("approval_instance_skips_requiredPosition")
  candidateGroupsRequiredPosition     approval_candidate_groups[]  @relation("approval_candidate_groups_requiredPosition")
  requestApprovalRows                 request_approvals[]          @relation("request_approvals_requiredPosition")
  solutionApprovalRows                solution_approvals[]        @relation("solution_approvals_requiredPosition")
}

model organization_assignments {
  id             String     @id @default(uuid())
  userId         String
  unitId         String
  positionId     String
  teamId         String?
  isActive       Boolean    @default(true)
  deactivatedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user            User                 @relation("organization_assignments_user", fields: [userId], references: [id], onDelete: Restrict)
  unit            organization_units   @relation("organization_assignments_unit", fields: [unitId], references: [id], onDelete: Restrict)
  position        positions            @relation("organization_assignments_position", fields: [positionId], references: [id], onDelete: Restrict)
  team            teams?               @relation("organization_assignments_team", fields: [teamId], references: [id], onDelete: SetNull)
  reportsForTeams teams[]              @relation("teams_reportsTo")
  originInstances approval_instances[] @relation("approval_instances_originAssignment")

  @@index([userId])
  @@index([unitId])
  @@index([positionId])
  @@index([teamId])
}

model teams {
  id                    String     @id @default(uuid())
  unitId                String
  name                  String
  reportsToAssignmentId String
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  unit      organization_units       @relation("teams_unit", fields: [unitId], references: [id], onDelete: Restrict)
  reportsTo organization_assignments @relation("teams_reportsTo", fields: [reportsToAssignmentId], references: [id], onDelete: Restrict)
  members   organization_assignments[] @relation("organization_assignments_team")

  @@index([unitId])
  @@index([reportsToAssignmentId])
}
