generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model department_approvers {
  id            String      @id @default(uuid())
  departmentId  String
  approverId    String
  approverLevel Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  approver      User       @relation(fields: [approverId], references: [id], onDelete: Cascade)
  department    departments @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, approverId, approverLevel])
  @@index([approverId])
  @@index([departmentId])
}

model departments {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  type                  DepartmentType
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  levelNames            Json?
  departmentApprovers   department_approvers[]
  budgetCodes           budget_codes[]
  hierarchyChangeLogs   hierarchy_change_logs[]
  requests              requests[]
  users                 User[]
  organizationUnit      organization_units?     @relation("organization_units_legacyDepartment")
}

model file_attachments {
  id           String     @id @default(uuid())
  requestId    String?
  fileName     String
  fileType     String
  fileSize     Int
  description  String?
  uploadedById String
  createdAt    DateTime   @default(now())
  filePath     String
  solutionId   String?
  request      requests?  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution     solutions? @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
  @@index([solutionId])
  @@index([uploadedById])
}

model inline_description_images {
  id                String                               @id @default(uuid())
  uploadedById      String
  uploadSessionId   String
  fileName          String
  fileType          String
  originalSize      Int
  fileSize          Int
  filePath          String
  width             Int
  height            Int
  deletionPendingAt DateTime?
  createdAt         DateTime                             @default(now())
  uploadedBy        User                                 @relation(fields: [uploadedById], references: [id])
  references        inline_description_image_references[]

  @@index([uploadedById])
  @@index([uploadSessionId])
  @@index([createdAt])
  @@index([deletionPendingAt])
}

model inline_description_image_references {
  id         String                    @id @default(uuid())
  imageId    String
  requestId  String?
  solutionId String?
  templateId String?
  createdAt  DateTime                  @default(now())
  image      inline_description_images @relation(fields: [imageId], references: [id], onDelete: Cascade)
  request    requests?                 @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution   solutions?                @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  template   templates?                @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([imageId, requestId])
  @@unique([imageId, solutionId])
  @@unique([imageId, templateId])
  @@index([imageId])
  @@index([requestId])
  @@index([solutionId])
  @@index([templateId])
}

model hierarchy_change_logs {
  id                                              String      @id @default(uuid())
  departmentId                                    String
  adminUserId                                     String
  targetUserId                                    String
  oldLevel                                        Int?
  newLevel                                        Int
  reason                                          String?
  createdAt                                       DateTime    @default(now())
  adminUser                                       User       @relation("hierarchy_change_logs_adminUserIdTousers", fields: [adminUserId], references: [id])
  department                                      departments @relation(fields: [departmentId], references: [id])
  targetUser                                      User       @relation("hierarchy_change_logs_targetUserIdTousers", fields: [targetUserId], references: [id])

  @@index([adminUserId])
  @@index([createdAt])
  @@index([departmentId])
  @@index([targetUserId])
}

model notifications {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  requestId String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  request   requests?        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([userId])
}

model request_activities {
  id         String         @id @default(uuid())
  requestId  String?
  action     String
  fromStatus RequestStatus?
  toStatus   RequestStatus?
  comments   String?
  userId     String
  createdAt  DateTime       @default(now())
  request    requests?      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([requestId])
  @@index([userId])
}

model request_approvals {
  id                                                String                       @id @default(uuid())
  requestId                                         String
  approverId                                        String?
  requiredLevel                                     Int?
  order                                             Int
  status                                            ApprovalStatus               @default(pending)
  comments                                          String?
  approvedAt                                        DateTime?
  createdAt                                         DateTime                     @default(now())
  isCustomChain                                     Boolean                      @default(false)
  isFinalApproval                                   Boolean                      @default(false)
  requiredApproverId                                String?
  instanceId                                        String?
  requiredPosition                                  OrganizationPositionCode?
  candidateGroupId                                  String?
  routingMode                                       ApprovalRoutingMode          @default(LEGACY_LEVEL)
  // 0 = legacy-compatible rows (historical null levels, deleted custom
  // approvers via SetNull, rows later wrapped into an instance). 1 = strict
  // NEW metadata enforced by the row-mode CHECK and the group-less snapshot
  // audit triggers. Future NEW instance persistence (Task 7/8) must create
  // rows with integrityVersion 1.
  integrityVersion                                  Int                          @default(0)
  approver                                          User?                        @relation("request_approvals_approverIdTousers", fields: [approverId], references: [id])
  request                                           requests                     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requiredApprover                                  User?                        @relation("request_approvals_requiredApproverIdTousers", fields: [requiredApproverId], references: [id])
  instance                                          approval_instances?          @relation("request_approval_instance", fields: [instanceId], references: [id], onDelete: Restrict)
  candidateGroup                                    approval_candidate_groups?   @relation("request_approval_candidate_group", fields: [candidateGroupId], references: [id], onDelete: Restrict)

  @@index([approverId])
  @@index([requestId])
  @@index([requiredApproverId])
  @@index([requiredLevel])
  @@index([status])
  @@index([instanceId])
  @@index([candidateGroupId])
}

model request_engineer_assignments {
  id           String   @id @default(uuid())
  requestId    String
  engineerId   String
  assignedAt   DateTime @default(now())
  assignedById String?
  engineer     User    @relation(fields: [engineerId], references: [id])
  request      requests @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([engineerId])
  @@index([requestId])
}

model sub_task_stages {
  id        String              @id @default(uuid())
  name      String              @unique
  sortOrder Int
  isDefault Boolean             @default(true)
  isOthers  Boolean             @default(false)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  subTasks  request_sub_tasks[]

  @@index([isActive])
  @@index([isOthers])
  @@index([sortOrder])
}

model sub_contractors {
  id          String              @id @default(uuid())
  name        String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String
  updatedById String?
  createdBy   User                @relation("sub_contractors_createdByIdTousers", fields: [createdById], references: [id])
  updatedBy   User?               @relation("sub_contractors_updatedByIdTousers", fields: [updatedById], references: [id])
  subTasks    request_sub_tasks[]

  @@index([createdById])
  @@index([isActive])
  @@index([updatedById])
}

model request_sub_tasks {
  id              String           @id @default(uuid())
  requestId       String
  description     String
  subContractorId String?
  stageId         String
  customStageText String?
  isCompleted     Boolean          @default(false)
  completedAt     DateTime?
  completedById   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String
  updatedById     String?
  request         requests         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subContractor   sub_contractors? @relation(fields: [subContractorId], references: [id], onDelete: SetNull)
  stage           sub_task_stages  @relation(fields: [stageId], references: [id])
  createdBy       User             @relation("request_sub_tasks_createdByIdTousers", fields: [createdById], references: [id])
  updatedBy       User?            @relation("request_sub_tasks_updatedByIdTousers", fields: [updatedById], references: [id])
  completedBy     User?            @relation("request_sub_tasks_completedByIdTousers", fields: [completedById], references: [id])

  @@index([completedById])
  @@index([createdById])
  @@index([isCompleted])
  @@index([requestId])
  @@index([stageId])
  @@index([subContractorId])
  @@index([updatedAt])
  @@index([updatedById])
}

model budget_codes {
  id           String     @id @default(uuid())
  code         String     @unique
  displayCode  String
  name         String?
  budgetAmount Decimal?   @db.Decimal(15, 2)
  departmentId String?
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    User?      @relation("budget_codes_createdByIdTousers", fields: [createdById], references: [id])
  department   departments? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  requests     requests[]

  @@index([createdById])
  @@index([departmentId])
  @@index([displayCode])
}

model requests {
  id                                String                         @id @default(uuid())
  title                             String
  description                       String
  status                            RequestStatus                  @default(ImprovementRequest)
  requesterId                       String
  departmentId                      String?
  organizationUnitId                String?
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  engineeringCostEstimate           Decimal?                       @db.Decimal(15, 2)
  engineeringSolution               String?
  deletedAt                         DateTime?
  deletedBy                         String?
  isDeleted                         Boolean                        @default(false)
  isArchived                        Boolean                        @default(false)
  budgetCodeId                      String?
  projectEstimateCost               Decimal?                       @db.Decimal(15, 2)
  workRequisitionReceived           Boolean                        @default(false)
  workRequisitionReceivedAt         DateTime?
  workRequisitionReceivedById       String?
  fileAttachments                   file_attachments[]
  inlineDescriptionImageReferences  inline_description_image_references[]
  notifications                     notifications[]
  activities                        request_activities[]
  approvals                         request_approvals[]
  engineerAssignments               request_engineer_assignments[]
  subTasks                          request_sub_tasks[]
  budgetCode                        budget_codes?                 @relation(fields: [budgetCodeId], references: [id], onDelete: SetNull)
  deletedByUser                     User?                         @relation("requests_deletedByTousers", fields: [deletedBy], references: [id])
  department                        departments?                  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  organizationUnit                  organization_units?           @relation(fields: [organizationUnitId], references: [id])
  requester                         User                          @relation("requests_requesterIdTousers", fields: [requesterId], references: [id])
  workRequisitionReceivedBy         User?                         @relation("requests_workRequisitionReceivedByIdTousers", fields: [workRequisitionReceivedById], references: [id])
  solutions                         solutions[]
  approvalInstances                 approval_instances[]

  @@index([budgetCodeId])
  @@index([createdAt])
  @@index([departmentId])
  @@index([isDeleted])
  @@index([organizationUnitId])
  @@index([requesterId])
  @@index([status])
  @@index([workRequisitionReceived])
  @@index([workRequisitionReceivedById])
}

model solution_approvals {
  id                                                 String                       @id @default(uuid())
  solutionId                                         String
  requiredLevel                                      Int?
  requiredApproverId                                 String?
  approverId                                         String?
  order                                              Int
  status                                             ApprovalStatus               @default(pending)
  comments                                           String?
  isCustomChain                                      Boolean                      @default(false)
  approvedAt                                         DateTime?
  createdAt                                          DateTime                     @default(now())
  instanceId                                         String?
  requiredPosition                                   OrganizationPositionCode?
  candidateGroupId                                   String?
  routingMode                                        ApprovalRoutingMode          @default(LEGACY_LEVEL)
  // Same versioning contract as request_approvals: 0 legacy-compatible,
  // 1 strict NEW metadata.
  integrityVersion                                   Int                          @default(0)
  approver                                           User?                        @relation("solution_approvals_approverIdTousers", fields: [approverId], references: [id])
  requiredApprover                                   User?                        @relation("solution_approvals_requiredApproverIdTousers", fields: [requiredApproverId], references: [id])
  solution                                           solutions                    @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  instance                                           approval_instances?          @relation("solution_approval_instance", fields: [instanceId], references: [id], onDelete: Restrict)
  candidateGroup                                     approval_candidate_groups?   @relation("solution_approval_candidate_group", fields: [candidateGroupId], references: [id], onDelete: Restrict)

  @@index([approverId])
  @@index([order])
  @@index([requiredApproverId])
  @@index([solutionId])
  @@index([status])
  @@index([instanceId])
  @@index([candidateGroupId])
}

model solutions {
  id                 String               @id @default(uuid())
  requestId          String
  title              String
  description        String
  costEstimate       Decimal              @db.Decimal(15, 2)
  currency           String               @default("THB")
  timeline           String?
  conceptDesign      String?
  submittedById      String
  submittedAt        DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  fileAttachments                 file_attachments[]
  inlineDescriptionImageReferences inline_description_image_references[]
  approvals                       solution_approvals[]
  approvalInstances               approval_instances[]
  request            requests             @relation(fields: [requestId], references: [id], onDelete: Cascade)
  submittedBy        User                @relation(fields: [submittedById], references: [id])

  @@index([createdAt])
  @@index([requestId])
  @@index([submittedById])
}

model templates {
  id          String   @id @default(uuid())
  name        String
  title       String
  description String
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt                       DateTime                             @default(now())
  updatedAt                       DateTime                             @updatedAt
  inlineDescriptionImageReferences inline_description_image_references[]

  @@index([isActive])
  @@index([isDefault])
}

model retention_settings {
  id                        String   @id @default("default")
  archiveEnabled            Boolean  @default(true)
  archiveAfterDays          Int      @default(90)
  archiveStatuses           Json
  cleanupAfterDays          Int      @default(365)
  archiveHour               Int      @default(2)
  archiveMinute             Int      @default(0)
  lastArchiveRunOn          String?
  storageAlertThresholdPct  Int      @default(0)
  lastStorageAlertOn        String?
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model storage_plan_events {
  id          String   @id @default(uuid())
  label       String
  plannedDate DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("storage_plan_events_createdByIdTousers", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([plannedDate])
}

model email_settings {
  id                String   @id @default("default")
  enabled           Boolean  @default(true)
  provider          String   @default("custom")
  host              String
  port              Int      @default(587)
  username          String?
  passwordEncrypted String?
  fromAddress       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model User {
  id                                                              String                         @id @default(uuid())
  email                                                           String                         @unique
  name                                                            String
  passwordHash                                                    String?
  departmentId                                                    String?
  role                                                            UserRole                       @default(general_dept)
  level                                                           Int?
  isActive                                                        Boolean                        @default(true)
  forcePasswordChange                                             Boolean                        @default(false)
  createdAt                                                       DateTime                       @default(now())
  updatedAt                                                       DateTime                       @updatedAt
  departmentApproverRoles                                        department_approvers[]
  fileAttachments                                                file_attachments[]
  inlineDescriptionImages                                        inline_description_images[]
  adminHierarchyChanges                                          hierarchy_change_logs[]        @relation("hierarchy_change_logs_adminUserIdTousers")
  targetHierarchyChanges                                         hierarchy_change_logs[]        @relation("hierarchy_change_logs_targetUserIdTousers")
  notifications                                                   notifications[]
  requestActivities                                              request_activities[]
  approvedRequests                                               request_approvals[]            @relation("request_approvals_approverIdTousers")
  requiredApprovalRequests                                       request_approvals[]            @relation("request_approvals_requiredApproverIdTousers")
  createdBudgetCodes                                             budget_codes[]                 @relation("budget_codes_createdByIdTousers")
  engineerAssignments                                            request_engineer_assignments[]
  createdSubTasks                                                request_sub_tasks[]            @relation("request_sub_tasks_createdByIdTousers")
  updatedSubTasks                                                request_sub_tasks[]            @relation("request_sub_tasks_updatedByIdTousers")
  completedSubTasks                                              request_sub_tasks[]            @relation("request_sub_tasks_completedByIdTousers")
  createdSubContractors                                          sub_contractors[]              @relation("sub_contractors_createdByIdTousers")
  updatedSubContractors                                          sub_contractors[]              @relation("sub_contractors_updatedByIdTousers")
  deletedRequests                                                requests[]                     @relation("requests_deletedByTousers")
  createdRequests                                                requests[]                     @relation("requests_requesterIdTousers")
  workRequisitionRequests                                        requests[]                     @relation("requests_workRequisitionReceivedByIdTousers")
  approvedSolutions                                              solution_approvals[]           @relation("solution_approvals_approverIdTousers")
  requiredApprovalSolutions                                      solution_approvals[]           @relation("solution_approvals_requiredApproverIdTousers")
  solutions                                                       solutions[]
  createdStoragePlanEvents                                        storage_plan_events[]         @relation("storage_plan_events_createdByIdTousers")
  organizationPositionAssignments                                 organization_position_assignments[]
  reportingGroupMembers                                           reporting_group_members[]
  createdApprovalRouteVersions                                    approval_route_versions[]
  approvalInstancesOrigin                                         approval_instances[]           @relation("approval_instances_originUser")
  department                                                     departments?                   @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@index([isActive])
  @@index([level])
  @@map("users")
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum DepartmentType {
  GENERAL
  ENGINEERING
}

enum NotificationType {
  approval_needed
  approval_granted
  approval_rejected
  status_changed
  request_assigned
  solution_ready
  final_approval_needed
}

enum RequestStatus {
  ImprovementRequest
  SentToEngineer
  SendBackToRequester
  Completed
  Cancelled
  DesignCostEstimationApproval
  FinalApproval
}

enum UserRole {
  admin
  general_dept
  engineering
}

// --- Additive organization/approval redesign models (Task 2) ---
// Behavior remains legacy-default until the controlled cutover; these models
// only add the target structure, the explicit routing discriminator, and the
// immutable snapshot/provenance storage.

enum OrganizationUnitType {
  FACTORY
  DIVISION
  DEPARTMENT
  SECTION
}

enum OrganizationPositionCode {
  STAFF
  SUPERVISOR
  SECTION_MANAGER
  DEPARTMENT_MANAGER
  DIVISION_MANAGER
  FACTORY_MANAGER
}

enum ApprovalPhase {
  REQUEST
  SOLUTION
  FINAL
}

enum ApprovalRouteStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ApprovalRoutingMode {
  LEGACY_LEVEL
  SNAPSHOT_GROUP
  CUSTOM_PERSON
}

enum ApprovalInstanceState {
  PENDING
  AUTO_APPROVED
  COMPLETED_NO_ELIGIBLE_STEPS
  APPROVED
  REJECTED
  CANCELLED
  SUPERSEDED
}

enum ApprovalSkipReason {
  VACANT_POSITION
}

model organization_units {
  id                    String                               @id @default(uuid())
  name                  String
  unitType              OrganizationUnitType
  parentId              String?
  legacyDepartmentId    String?                              @unique
  isActive              Boolean                              @default(true)
  operationalType       DepartmentType                       @default(GENERAL)
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt
  parent                organization_units?                  @relation("organization_units_parent", fields: [parentId], references: [id])
  children              organization_units[]                 @relation("organization_units_parent")
  legacyDepartment      departments?                         @relation("organization_units_legacyDepartment", fields: [legacyDepartmentId], references: [id], onDelete: SetNull)
  positionAssignments   organization_position_assignments[]
  reportingGroups       reporting_groups[]
  routeVersions         approval_route_versions[]
  approvalInstances     approval_instances[]
  requests              requests[]

  @@index([parentId])
  @@index([unitType, isActive])
}

model organization_position_assignments {
  id               String                    @id @default(uuid())
  userId           String
  unitId           String
  positionCode     OrganizationPositionCode
  reportingGroupId String?
  isPrimary        Boolean                   @default(false)
  isActive         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  unit             organization_units        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reportingGroup   reporting_groups?         @relation(fields: [reportingGroupId], references: [id], onDelete: SetNull)

  @@unique([userId, unitId, positionCode])
  @@index([unitId, positionCode, isActive])
  @@index([userId, isPrimary, isActive])
}

model reporting_groups {
  id                  String                               @id @default(uuid())
  unitId              String
  parentGroupId       String?
  name                String
  isActive            Boolean                              @default(true)
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt
  unit                organization_units                   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  parent              reporting_groups?                    @relation("reporting_groups_parent", fields: [parentGroupId], references: [id])
  children            reporting_groups[]                   @relation("reporting_groups_parent")
  members             reporting_group_members[]
  positionAssignments organization_position_assignments[]

  @@unique([unitId, name])
  @@index([parentGroupId])
}

model reporting_group_members {
  reportingGroupId String
  userId           String
  createdAt        DateTime          @default(now())
  reportingGroup   reporting_groups  @relation(fields: [reportingGroupId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([reportingGroupId, userId])
  @@index([userId])
}

model approval_route_versions {
  id                   String                  @id @default(uuid())
  scopeUnitId          String
  phase                ApprovalPhase
  version              Int
  maximumPositionLevel Int
  status               ApprovalRouteStatus     @default(DRAFT)
  createdById          String
  createdAt            DateTime                @default(now())
  publishedAt          DateTime?
  scopeUnit            organization_units      @relation(fields: [scopeUnitId], references: [id], onDelete: Restrict)
  createdBy            User                    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  steps                approval_route_steps[]
  instances            approval_instances[]

  @@unique([scopeUnitId, phase, version])
  @@index([scopeUnitId, phase, status])
}

model approval_route_steps {
  id               String                    @id @default(uuid())
  routeVersionId   String
  stepOrder        Int
  positionCode     OrganizationPositionCode
  createdAt        DateTime                  @default(now())
  routeVersion     approval_route_versions   @relation(fields: [routeVersionId], references: [id], onDelete: Cascade)
  skippedInstances approval_instance_skips[]

  @@unique([routeVersionId, stepOrder])
  @@unique([routeVersionId, positionCode])
}

model approval_instances {
  id               String                     @id @default(uuid())
  requestId        String?
  solutionId       String?
  phase            ApprovalPhase
  routeVersionId   String?
  originUserId     String
  originUnitId     String
  originContext    Json
  routingMode      ApprovalRoutingMode
  state            ApprovalInstanceState      @default(PENDING)
  attempt          Int                        @default(1)
  completionReason String?
  createdAt        DateTime                   @default(now())
  // Task 8 ruling: supersession sets supersededAt while PRESERVING the prior
  // terminal state — AUTO_APPROVED is never erased into SUPERSEDED. The state
  // stays the durable audit proof for group-less auto self-rows.
  supersededAt     DateTime?
  request          requests?                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  solution         solutions?                 @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  routeVersion     approval_route_versions?   @relation(fields: [routeVersionId], references: [id], onDelete: Restrict)
  originUser       User                       @relation("approval_instances_originUser", fields: [originUserId], references: [id], onDelete: Restrict)
  originUnit       organization_units         @relation(fields: [originUnitId], references: [id], onDelete: Restrict)
  requestApprovals request_approvals[]        @relation("request_approval_instance")
  solutionApprovals solution_approvals[]      @relation("solution_approval_instance")
  skips            approval_instance_skips[]
  candidateGroups  approval_candidate_groups[]

  @@index([requestId, phase, supersededAt])
  @@index([solutionId, phase, supersededAt])
  @@index([routeVersionId])
  @@unique([requestId, phase, attempt])
  @@unique([solutionId, phase, attempt])
}

model approval_instance_skips {
  id                String                    @id @default(uuid())
  approvalInstanceId String
  routeStepId       String?
  requiredPosition  OrganizationPositionCode
  reason            ApprovalSkipReason
  createdAt         DateTime                  @default(now())
  approvalInstance  approval_instances        @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  routeStep         approval_route_steps?     @relation(fields: [routeStepId], references: [id], onDelete: SetNull)

  @@unique([approvalInstanceId, requiredPosition])
}

model approval_candidate_groups {
  id                 String                               @id @default(uuid())
  approvalInstanceId String
  requiredPosition   OrganizationPositionCode
  scopeUnitId        String
  capturedAt         DateTime                             @default(now())
  approvalInstance   approval_instances                   @relation(fields: [approvalInstanceId], references: [id], onDelete: Cascade)
  members            approval_candidate_group_members[]
  requestApprovals   request_approvals[]                  @relation("request_approval_candidate_group")
  solutionApprovals  solution_approvals[]                 @relation("solution_approval_candidate_group")

  @@unique([approvalInstanceId, requiredPosition])
  @@index([scopeUnitId])
}

model approval_candidate_group_members {
  candidateGroupId    String
  userId              String
  capturedAt          DateTime                    @default(now())
  capturedDisplayName String
  candidateGroup      approval_candidate_groups   @relation(fields: [candidateGroupId], references: [id], onDelete: Cascade)

  @@id([candidateGroupId, userId])
  @@index([userId])
}

model organization_import_runs {
  id             String   @id @default(uuid())
  mappingDigest  String   @unique
  appliedAt      DateTime @default(now())
  appliedBy      String
  targetIdentity String
  counts         Json
}
